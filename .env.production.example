# Copiar a .env.production en el servidor (no se sube a git) y llenar los valores vacíos.
# Lo leen docker compose (contraseñas de Postgres y WhatsApp) y Laravel (env_file).
APP_NAME="Motorepuestos Mota"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fadeaap.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=America/Guatemala

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pedidos
DB_USERNAME=pedidos
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log

WHATSAPP_URL=http://pedidos_whatsapp:3000
WHATSAPP_TOKEN=
WHATSAPP_COUNTRY_CODE=502
WHATSAPP_MEM_LIMIT=1200m

PROXY_NETWORK=taller-sis_default

NEGOCIO_NOMBRE="Motorepuestos Mota"
NEGOCIO_TELEFONO=
NEGOCIO_DIRECCION=
NEGOCIO_NIT=
